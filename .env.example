# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and adjust variables for your local/production environment.
# DO NOT COMMIT .env TO SOURCE CONTROL.
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database Configuration (SQLite default for local development)
DB_CLIENT=sqlite
DB_FILE=database/appointment_system.db

# Production Database (e.g. PostgreSQL)
# DB_CLIENT=pg
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ts_appointment_db
# DB_USER=db_user
# DB_PASSWORD=your_secure_password_here
# DB_SSL=false

# Authentication Secrets
# Generate a strong 64-char key in production: openssl rand -base64 32
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=24h

# Application URLs & CORS
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
