# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and adjust variables for your local/production environment.
# DO NOT COMMIT .env TO SOURCE CONTROL.
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database Configuration (SQLite default for local development)
DB_CLIENT=sqlite
DB_FILE=database/appointment_system.db

# Production Database (e.g. PostgreSQL)
# DB_CLIENT=pg
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ts_appointment_db
# DB_USER=db_user
# DB_PASSWORD=your_secure_password_here
# DB_SSL=false

# Authentication Secrets
# Generate a strong 64-char key in production: openssl rand -base64 32
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=24h

# Application URLs & CORS
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ==============================================================================
# Outbound Transactional Email Configuration (SMTP / Disabled / Mock)
# ==============================================================================
# Transport Mode Options:
# - 'disabled': Disables all outbound email delivery. The application operates
#   completely without external email providers (e.g., Brevo, SendGrid, Gmail SMTP).
#   Forgot-password requests safely inform users that email recovery is unavailable.
# - 'smtp': Production delivery via an authenticated SMTP relay.
# - 'mock': In-memory outbox for local testing (default in development/test).
EMAIL_TRANSPORT=disabled

# SMTP Server Settings (Required when EMAIL_TRANSPORT=smtp)
# Example for SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587, SMTP_USER=apikey
# Example for Mailgun:  SMTP_HOST=smtp.mailgun.org,  SMTP_PORT=587, SMTP_USER=postmaster@your-domain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=University Appointment System <no-reply@university.edu>
